# ==========================================
# RENDER BACKEND CONFIGURATION
# ==========================================
# PORT: The port the Express backend listens on (Render automatically injects PORT=10000)
PORT=3000

# DATABASE_URL: Optional PostgreSQL connection string.
# On Render: Attach a PostgreSQL Database (e.g. postgres://user:pass@host/db).
# If not provided, backend automatically uses persistent Cloud DBMS on disk so data is never lost!
DATABASE_URL=""

# CORS_ORIGIN: Allowed origins for Vercel frontend.
# Set to your Vercel URL (e.g. https://your-project.vercel.app) or "*" for all.
CORS_ORIGIN="*"

# ==========================================
# VERCEL FRONTEND CONFIGURATION
# ==========================================
# VITE_API_BASE_URL: The URL of your deployed Render backend.
# Example: https://battery-register-backend.onrender.com
# Leave blank during local development.
VITE_API_BASE_URL="https://stock-management-hbuv.onrender.com"

# ==========================================
# OPTIONAL WHATSAPP BUSINESS CLOUD API
# ==========================================
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
